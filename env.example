# Copy to `clara.env` and edit. Loaded by docker-compose and by `clara` locally.
# NOTE: this repo's `.env/` is a Python virtualenv directory, so config lives in
# `clara.env` rather than `.env` to avoid the collision.

# ---------------------------------------------------------------- control plane
CLARA_ENV=local
CLARA_LOG_LEVEL=INFO
CLARA_API_HOST=0.0.0.0
CLARA_API_PORT=8080
# SQLite for local, Postgres for anything shared.
CLARA_DATABASE_URL=sqlite:///./.clara/control_plane.db
# CLARA_DATABASE_URL=postgresql+psycopg://clara:clara@postgres:5432/clara

# Root API key minted on first boot. Leave blank to have one generated & printed.
CLARA_BOOTSTRAP_API_KEY=

# ---------------------------------------------------------------------- storage
# Any S3-compatible endpoint: AWS S3, MinIO, Tencent COS, Alibaba OSS, Backblaze...
CLARA_PROVIDER=local
CLARA_STORAGE_BUCKET=clara-lakehouse
CLARA_STORAGE_ENDPOINT=http://minio:9000
CLARA_STORAGE_REGION=us-east-1
CLARA_STORAGE_ACCESS_KEY=clara
CLARA_STORAGE_SECRET_KEY=clara-dev-secret
CLARA_STORAGE_PATH_STYLE=true

# ---------------------------------------------------------------------- catalog
# memory | sqlite | rest  (rest = Iceberg REST catalog, e.g. Lakekeeper/Polaris/Nessie)
CLARA_CATALOG_KIND=sqlite
CLARA_CATALOG_URI=sqlite:///./.clara/iceberg_catalog.db
CLARA_CATALOG_WAREHOUSE=s3://clara-lakehouse/warehouse

# ---------------------------------------------------------------------- engines
CLARA_TRINO_HOST=trino
CLARA_TRINO_PORT=8080
CLARA_TRINO_USER=clara
CLARA_TRINO_CATALOG=iceberg
CLARA_TRINO_SCHEMA=main
CLARA_DUCKDB_PATH=./.clara/duckdb/local.duckdb

# ---------------------------------------------------------------------- billing
# Rate card the metering engine prices usage against (see docs/pricing.md).
CLARA_RATE_CARD=default
CLARA_PLAN=trial
CLARA_CURRENCY=USD

# ------------------------------------------------------------ example connector
SOURCE_POSTGRES_HOST=postgres
SOURCE_POSTGRES_PORT=5432
SOURCE_POSTGRES_DB=clara
SOURCE_POSTGRES_USER=clara
SOURCE_POSTGRES_PASSWORD=clara